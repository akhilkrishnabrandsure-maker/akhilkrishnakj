# ==============================================================================
# Akhil Krishna Portfolio - Environment Variables
# Copy this file to `.env.local` and populate with your verified credentials.
# ==============================================================================

# Public URL of the portfolio website (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "false" in production to hide dashed "to be added" review notes & placeholders
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true

# Resend Email Delivery API (https://resend.com)
# When provided, contact inquiries route directly to your destination inbox.
# If omitted, contact submissions are safely validated and logged server-side.
RESEND_API_KEY=

# Destination email where inquiries should arrive
CONTACT_EMAIL=

# Verified sender address in Resend (default: onboarding@resend.dev for testing)
FROM_EMAIL="Akhil Krishna Portfolio <onboarding@resend.dev>"
